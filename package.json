{
  "name": "machinist-calc",
  "productName": "Machinist Calc",
  "version": "0.2.0",
  "description": "Offline machinist calculator suite: thread calcs, tap drills, speeds & feeds, surface finish, bolt circle, true position, tolerances, and reference charts.",
  "main": "main.js",
  "author": {
    "name": "Allan",
    "email": "allann2020@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node tests/run.js",
    "lint": "eslint .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.9.0"
  },
  "build": {
    "appId": "com.allan.machinistcalc",
    "productName": "Machinist Calc",
    "icon": "build/icon.png",
    "publish": {
      "provider": "github",
      "owner": "i-machine-things",
      "repo": "machinist-calc",
      "releaseType": "release"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.ico",
      "build/icon.icns",
      "build/icon.png"
    ],
    "directories": {
      "output": "release"
    }
  }
}
